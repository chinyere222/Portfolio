:root{--bg:#15111c;--sf:#201a2a;--ln:#3a3048;--tx:#f6f1f9;--mu:#d6cbe0;--ac:#e2a6f2;--ac2:#1f2d52;--r:18px;--hf:'Bricolage Grotesque','Arial Black',sans-serif;--bf:'DM Sans',system-ui,sans-serif;box-sizing:border-box;padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px)}

@media(prefers-color-scheme:light){:root:not([data-theme="dark"]){--bg:#15111c}
}

*,*::before,*::after{box-sizing:inherit}
html{scroll-padding-top:env(safe-area-inset-top,0px);height:100%}

body{margin:0;background:var(--bg);color:var(--tx);font:400 17px/1.65 var(--bf);min-height:100%;-webkit-font-smoothing:antialiased}

a{color:inherit;text-decoration:none}
img,video{max-width:100%;display:block}

:focus-visible{outline:3px solid var(--ac);outline-offset:3px;border-radius:6px}

h1,h2,h3{font-family:var(--hf);line-height:1.08;margin:0;letter-spacing:-.02em}

h1{font-size:clamp(2.2rem,5vw,3.6rem);font-weight:800}
h2{font-size:clamp(1.6rem,3vw,2.2rem);font-weight:700}
h3{font-size:1.25rem;font-weight:700}

p{margin:0 0 1em;color:var(--mu);max-width:62ch}

.side{position:fixed;inset:0 auto 0 0;width:270px;padding:28px 22px;padding-top:calc(28px + env(safe-area-inset-top,0px));background:#110d18;border-right:1px solid var(--ln);display:flex;flex-direction:column;gap:26px;z-index:20;overflow:auto}

.brand b{font:800 1.9rem var(--hf);display:block;color:var(--ac)}
.brand span{font-size:.9rem;color:var(--mu)}

nav a,.gh{display:block;width:100%;text-align:left;padding:10px 12px;border-radius:10px;color:var(--mu);font:500 1rem var(--bf);background:none;border:0;cursor:pointer}

nav a:hover,.gh:hover{background:var(--sf);color:var(--tx)}
nav a.on{background:var(--ac);color:#1a1022;font-weight:700}

.gh{display:flex;justify-content:space-between;color:var(--tx);font-weight:700}
.gh::after{content:"+";color:var(--ac)}
.grp.open .gh::after{content:"–"}

.grp ul{list-style:none;margin:0;padding:0 0 0 8px;display:grid;grid-template-rows:0fr;transition:grid-template-rows .25s}
.grp.open ul{grid-template-rows:1fr}
.grp ul>div{overflow:hidden}

.btn{display:inline-flex;align-items:center;gap:8px;padding:13px 22px;border-radius:999px;background:var(--ac);color:#1a1022;font:700 1rem var(--bf);border:2px solid var(--ac);cursor:pointer}

.btn:hover{background:#efc3fa}
.btn.ghost{background:none;color:var(--tx);border-color:var(--ln)}
.btn.ghost:hover{border-color:var(--ac);background:none}

.bar{display:none}
main{margin-left:270px}
.pg{display:none}
.pg.on{display:block;animation:in .35s}
@keyframes in{from{opacity:0}
to{opacity:1}
}

.wrap{max-width:1080px;margin:0 auto;padding:56px 40px 72px}

.lead{font-size:1.2rem;color:var(--tx);max-width:56ch}
.sec{margin-top:56px}

.hero{border-radius:var(--r);overflow:hidden;background:#e2a6f2;cursor:zoom-in}
.hero img{width:100%;height:auto}

.intro{display:grid;grid-template-columns:1.3fr 1fr;gap:40px;margin-top:40px;align-items:start}

.pills{display:flex;flex-wrap:wrap;gap:10px;margin:0;padding:0;list-style:none}
.pills li{border:1px solid var(--ln);border-radius:999px;padding:8px 16px;color:var(--tx);background:var(--sf)}

.cards{display:grid;grid-template-columns:repeat(auto-fit,minmax(250px,1fr));gap:20px;margin-top:28px}

.card{background:var(--sf);border:1px solid var(--ln);border-radius:var(--r);padding:26px}
.card h3{margin-bottom:10px;color:var(--ac)}
.card p{margin:0}

.svc{display:grid;grid-template-columns:minmax(0,360px) 1fr;gap:48px;margin-top:36px;align-items:start}

.svc figure{margin:0;position:sticky;top:32px}
.svc figure img{border-radius:var(--r);width:100%;border:1px solid var(--ln)}

.svc ul{list-style:none;margin:0;padding:0}
.svc li{padding:24px 0;border-top:1px solid var(--ln)}
.svc li:last-child{border-bottom:1px solid var(--ln)}
.svc li h3{margin-bottom:8px}
.svc li p{margin:0}

.vids{display:grid;grid-template-columns:repeat(auto-fill,minmax(220px,1fr));gap:22px;margin-top:32px}

.v{position:relative;border-radius:var(--r);overflow:hidden;background:#000;aspect-ratio:9/16;border:1px solid var(--ln)}
.v video{width:100%;height:100%;object-fit:cover}

.v figcaption{position:absolute;left:0;right:0;bottom:0;padding:44px 14px 14px;background:linear-gradient(transparent,rgba(10,6,14,.88));font:700 1rem var(--hf)}

.mute{position:absolute;top:10px;right:10px;width:42px;height:42px;border-radius:50%;border:0;background:rgba(15,10,20,.72);color:#fff;cursor:pointer;display:grid;place-items:center}

.mute svg{width:20px;height:20px;fill:none;stroke:currentColor;stroke-width:2;stroke-linecap:round;stroke-linejoin:round}
.mute .on{display:none}
.mute.snd .on{display:block}
.mute.snd .off{display:none}

.tap{display:none;position:absolute;inset:0;margin:auto;width:64px;height:64px;border-radius:50%;border:0;background:var(--ac);color:#1a1022;font-size:1.4rem;cursor:pointer}
.v.needs .tap{display:block}

.prof{display:grid;grid-template-columns:1fr 1fr;gap:32px;margin-top:32px}
.prof .card p,.prof li{color:#f1e9f6}
.prof ul{margin:0;padding-left:1.1em}
.prof li{margin-bottom:.5em}

.row{display:flex;align-items:center;gap:18px;padding:20px 22px;border:1px solid var(--ln);border-radius:var(--r);background:var(--sf);margin-bottom:14px;max-width:560px}
.row:hover{border-color:var(--ac)}

.ic{width:46px;height:46px;border-radius:50%;background:var(--ac);display:grid;place-items:center;flex:none}
.ic svg{width:22px;height:22px;fill:none;stroke:#1a1022;stroke-width:2;stroke-linecap:round;stroke-linejoin:round}

.row small{display:block;color:var(--mu)}
.row b{font-size:1.05rem;word-break:break-all}

.pn{display:flex;justify-content:space-between;gap:16px;margin-top:64px;padding-top:24px;border-top:1px solid var(--ln)}
.pn a{display:inline-flex;gap:8px;align-items:center;color:var(--mu);font-weight:500}
.pn a:hover{color:var(--ac)}

.gal{display:grid;grid-template-columns:repeat(auto-fit,minmax(280px,1fr));gap:20px;margin-top:28px}
.zoomable{margin:0;border-radius:var(--r);overflow:hidden;border:1px solid var(--ln);cursor:zoom-in;background:var(--sf)}
.zoomable figcaption{padding:14px 18px;color:var(--mu);font-size:.95rem}

.lb{position:fixed;inset:0;background:rgba(10,6,14,.94);display:none;place-items:center;z-index:50;padding:24px}
.lb.on{display:grid}
.lb img{max-height:86vh;border-radius:12px}
.lb button{position:absolute;top:calc(16px + env(safe-area-inset-top,0px));right:16px;padding:10px 18px;border-radius:999px;border:0;background:var(--ac);font:700 1rem var(--bf);cursor:pointer}

@media(max-width:860px){body{font-size:16px}
.side{transform:translateX(-100%);transition:transform .25s;width:min(300px,86vw)}
body.menu .side{transform:none}

.bar{display:flex;position:fixed;top:0;left:0;right:0;z-index:30;justify-content:space-between;align-items:center;padding:12px 18px;padding-top:calc(12px + env(safe-area-inset-top,0px));background:#110d18;border-bottom:1px solid var(--ln);font:800 1.3rem var(--hf);color:var(--ac)}

.bar button{background:var(--ac);border:0;border-radius:999px;padding:9px 18px;font:700 .95rem var(--bf);color:#1a1022}

main{margin:0;padding-top:calc(62px + env(safe-area-inset-top,0px))}
.wrap{padding:32px 20px 56px}
.intro,.svc,.prof{grid-template-columns:1fr}
.svc figure{position:static;max-width:380px}
}

@media(prefers-reduced-motion:reduce){*{animation:none!important;transition:none!important}
}

.pf{display:grid;grid-template-columns:1.2fr 1fr;gap:48px;align-items:start}
.pf h1{margin-bottom:24px}
.pf p{color:#f4edf8;font-size:1.1rem;line-height:1.75}
.pf .btn{margin-top:12px}
.pp{margin:0;position:sticky;top:32px}
.pp img{width:100%;border-radius:var(--r);border:1px solid var(--ln)}

.gal.sq{grid-template-columns:repeat(auto-fill,minmax(230px,1fr))}
.gal.sh{grid-template-columns:repeat(auto-fill,minmax(300px,1fr));align-items:start}
.zoomable img{width:100%;height:auto}

.stats{display:grid;grid-template-columns:repeat(auto-fit,minmax(210px,1fr));gap:16px;margin:32px 0}
.stats .card{padding:22px}
.stats b{display:block;font:800 2.2rem var(--hf);color:var(--ac);letter-spacing:-.02em}
.stats span{color:var(--mu);font-size:.95rem;line-height:1.4;display:block;margin-top:6px}

a.lk:hover{border-color:var(--ac)}
.sec h2,h2.sec{margin-bottom:6px}

@media(max-width:860px){.pf{grid-template-columns:1fr}
.pp{position:static;max-width:380px}
}

.stage{position:relative;min-height:100vh;min-height:100svh;overflow:hidden;background:#e2a6f2;color:#000}

.bars{position:absolute;inset:0 0 45% 0;background:repeating-linear-gradient(90deg,transparent 0 8%,#fff 8% 17.5%);background-position:6% 0}

.wt{position:absolute;left:0;right:0;top:17%;text-align:center;font:400 clamp(2.6rem,8.2vw,6.5rem)/1.05 'Anton','Impact',sans-serif;color:#000;letter-spacing:.005em;text-shadow:2px 0 #19e3e3,-2px 0 #e319c0;padding:0 16px}

.exw{position:absolute;left:0;right:0;top:63%;display:flex;flex-direction:column;align-items:center;gap:22px}

.rule{display:block;width:min(62%,640px);height:3px;background:#fff;margin-left:14%}

.ex{display:inline-flex;align-items:center;gap:12px;font:800 1.35rem var(--bf);letter-spacing:.28em;text-transform:uppercase;color:#000;padding:14px 26px;border-radius:999px;border:3px solid #000;background:#fff;box-shadow:5px 5px 0 #000;transition:transform .15s,box-shadow .15s}

.ex svg{width:22px;height:22px;fill:none;stroke:#000;stroke-width:2.6;stroke-linecap:round;stroke-linejoin:round;animation:nudge 1.1s ease-in-out infinite}

.ex:hover{transform:translate(2px,2px);box-shadow:3px 3px 0 #000}
.ex:focus-visible{outline-color:#000}

@keyframes nudge{50%{transform:translateX(6px)}
}

.bun{position:absolute;bottom:-14px;left:2%;width:clamp(150px,22vw,240px);animation:stroll 22s ease-in-out infinite alternate}

.bf{animation:flip 44s steps(1) infinite}
.bf img{width:100%;height:auto;transform-origin:50% 90%;animation:hop .62s ease-in-out infinite alternate}

@keyframes stroll{from{left:2%}
to{left:calc(100% - clamp(150px,22vw,240px) - 2%)}
}

@keyframes flip{0%{transform:scaleX(1)}
50%{transform:scaleX(-1)}
}

@keyframes hop{from{transform:translateY(0) rotate(-3.5deg)}
to{transform:translateY(-16px) rotate(3.5deg)}
}

.trip{list-style:none;margin:0;padding:0 0 0 26px;position:relative;counter-reset:none}
.trip::before{content:"";position:absolute;left:5px;top:18px;bottom:18px;width:2px;background:var(--ln)}

.svc .trip li{position:relative;margin-bottom:14px;padding:0;border:0}
.svc .trip li:last-child{border:0}
.trip li::before{content:"";position:absolute;left:-26px;top:30px;width:12px;height:12px;border-radius:50%;background:var(--ac);box-shadow:0 0 0 4px var(--bg)}

.trip a{display:block;padding:22px 24px;border:1px solid var(--ln);border-radius:var(--r);background:var(--sf);transition:border-color .2s,transform .2s}

.trip a:hover,.trip a:focus-visible{border-color:var(--ac);transform:translateX(4px)}
.trip h3{margin-bottom:6px}
.trip p{margin:0 0 10px}
.trip span{color:var(--ac);font-weight:700}
.trip span::after{content:" \2192"}

.mas{columns:3 250px;column-gap:18px;margin-top:28px}
.mas .zoomable{break-inside:avoid;margin:0 0 18px;display:block}

@media(max-width:860px){.stage{min-height:calc(100svh - 62px)}
.wt{top:14%}
.exw{top:60%}
.rule{margin-left:0;width:60%}
}

@media(prefers-reduced-motion:reduce){.bun,.bf,.bf img,.ex svg{animation:none!important}
}
